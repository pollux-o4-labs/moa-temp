# Firebase Web SDK values are browser configuration, not service-account secrets.
# Keep real environment files local and never add service-account JSON or tokens.
VITE_BASE_PATH=/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=timep-tp
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_EMULATOR=false
VITE_FIREBASE_FIRESTORE_EMULATOR=false
