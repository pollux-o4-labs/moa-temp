{
  "name": "moa-temp",
  "version": "0.1.0",
  "description": "모아의 공개 브라우저 프론트엔드",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "yarn install --immutable",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test --test-concurrency=4 tests/*.test.mjs",
    "firebase:deploy": "yarn build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.0",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.4",
    "fast-check": "^4.10.0",
    "firebase-tools": "^15.30.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.39.0",
    "vite": "8.0.13"
  },
  "type": "module"
}
